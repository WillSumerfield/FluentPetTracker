# Secrets / local config
.env
.env.*
*.secret
secrets.yaml

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Frigate runtime data (recordings, database, model cache)
frigate/storage/
frigate/config/*
!frigate/config/config.yml

# Logs & media (recordings/clips can get large)
*.log
*.mp4
*.mkv

# Correlator runtime data (database and Clips)
correlator/data/

# Word Detection runtime data (an Enrolment Recording waiting to be saved)
word-detection/data/

# Home Assistant runtime data (its own database, accounts and caches)
home-assistant/config/*
!home-assistant/config/configuration.yaml
!home-assistant/config/dashboards/

# Planning notes (local only)
temp/
