# Secrets / local config
.env
# Your own settings, and every file configure.py writes from them (see config.example.yml)
/config.yml
/frigate/*.env
/frigate/relay/mediamtx.yml
/rpi-capture/capture.env
.env.*
*.secret
secrets.yaml

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Frigate runtime data (recordings, database, model cache)
frigate/storage/
frigate/config/*

# Logs & media (recordings/clips can get large)
*.log
*.mp4
*.mkv

# Correlator runtime data (database and Clips)
correlator/data/

# Word Detection runtime data (the Reference Clips, and an Enrolment Recording waiting to be saved)
word-detection/data/
word-detection/references/

# Home Assistant runtime data (its own database, accounts and caches)
home-assistant/config/*
!home-assistant/config/dashboards/

# Planning notes (local only)
temp/
